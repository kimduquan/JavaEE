{
  "name": "epf-agent-webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:infra && concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "dev:ui": "next dev --turbopack",
    "dev:agent": "./scripts/run-agent.sh",
    "build": "next build",
    "start": "next start",
    "install:agent": "./scripts/setup-agent.sh",
    "postinstall": "npm run install:agent",
    "dev:infra": "node scripts/copilotkit-dev-infra.mjs"
  },
  "dependencies": {
    "@copilotkit/a2ui-renderer": "1.63.1",
    "@copilotkit/react-core": "1.63.1",
    "@copilotkit/runtime": "1.63.1",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-separator": "^1.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.30",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-rnd": "^10.5.3",
    "react18-json-view": "^0.2.10",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "next-auth": "^4.24.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
